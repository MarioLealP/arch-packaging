{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":semanticCommitsDisabled"],
  "timezone": "Europe/Lisbon",
  "schedule": ["* 4-7 * * 0"],
  "minimumReleaseAge": "7 days",
  "labels": ["renovate"],
  "automerge": false,
  "packageRules": [
    {
      "description": "this repo IS the shared pipeline — every bump (checkout/rust-cache/release-action, archlinux base image) is a reviewed PR, never auto-merged",
      "matchPackageNames": ["*"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
